<div class="space-y-6">
  <!-- KPI Stat Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    {{#each stats}}
    <div class="bg-white dark:bg-slate-800 p-6 rounded-xl border border-slate-200 dark:border-slate-700 flex justify-between items-start">
      <div>
        <p class="text-sm font-medium text-slate-500 dark:text-slate-400">{{this.title}}</p>
        <h3 class="text-2xl font-bold mt-2">{{this.value}}</h3>
        <p class="text-xs font-semibold mt-2 {{#if this.isPositive}}text-emerald-500{{else}}text-rose-500{{/if}}">
          {{this.change}} so với tháng trước
        </p>
      </div>
      <div class="p-3 bg-brand-50 dark:bg-brand-600/20 text-brand-600 rounded-lg">
        <i data-lucide="{{this.icon}}" class="w-6 h-6"></i>
      </div>
    </div>
    {{/each}}
  </div>

  <!-- Charts Row -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 bg-white dark:bg-slate-800 p-6 rounded-xl border border-slate-200 dark:border-slate-700">
      <h3 class="font-bold text-lg mb-4">Doanh thu năm {{currentYear}}</h3>
      <div class="h-72">
        <canvas id="revenueChart"></canvas>
      </div>
    </div>
    <div class="bg-white dark:bg-slate-800 p-6 rounded-xl border border-slate-200 dark:border-slate-700">
      <h3 class="font-bold text-lg mb-4">Tỷ lệ danh mục</h3>
      <div class="h-72">
        <canvas id="categoryChart"></canvas>
      </div>
    </div>
  </div>
</div>