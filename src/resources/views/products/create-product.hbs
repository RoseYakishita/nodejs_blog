<div class="bg-white p-6 md:p-8 rounded-xl shadow-md max-w-4xl w-full border border-slate-100 mx-auto my-6">
  <h2 class="text-2xl font-bold text-slate-800 text-center mb-6">Thêm mới sản phẩm</h2>

  <form action="/products/store" method="POST" enctype="multipart/form-data" class="space-y-6">
    
    <!-- THÔNG TIN CƠ BẢN -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Tên sản phẩm -->
      <div class="md:col-span-2">
        <label for="name" class="block font-medium text-sm text-slate-700 mb-1">Tên sản phẩm <span class="text-rose-500">*</span></label>
        <input type="text" id="name" name="name" maxlength="200" required class="w-full p-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="Nhập tên sản phẩm...">
      </div>

      <!-- Mã SKU -->
      {{!-- <div>
        <label for="sku" class="block font-medium text-sm text-slate-700 mb-1">Mã SKU <span class="text-rose-500">*</span></label>
        <input type="text" id="sku" name="sku" required class="w-full p-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none uppercase" placeholder="VD: SP-CHAIR-01">
      </div> --}}

      <!-- Danh mục -->
      {{!-- <div>
        <label for="category" class="block font-medium text-sm text-slate-700 mb-1">Danh mục <span class="text-rose-500">*</span></label>
        <select id="category" name="category" required class="w-full p-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none bg-white">
          <option value="">-- Chọn danh mục --</option>
          {{#each categories}}
            <option value="{{this._id}}">{{this.name}}</option>
          {{/each}}
        </select>
      </div> --}}

      <!-- Giá bán -->
      <div>
        <label for="price" class="block font-medium text-sm text-slate-700 mb-1">Giá bán (VNĐ) <span class="text-rose-500">*</span></label>
        <input type="number" id="price" name="price" min="0" required class="w-full p-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="0">
      </div>

      <!-- Giá gốc (Giá thị trường) -->
      <div>
        <label for="originalPrice" class="block font-medium text-sm text-slate-700 mb-1">Giá gốc / Chưa giảm (VNĐ)</label>
        <input type="number" id="originalPrice" name="originalPrice" min="0" value="0" class="w-full p-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="0">
      </div>

      <!-- Tồn kho -->
      <div>
        <label for="stock" class="block font-medium text-sm text-slate-700 mb-1">Số lượng tồn kho <span class="text-rose-500">*</span></label>
        <input type="number" id="stock" name="stock" min="0" value="0" required class="w-full p-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>

      <!-- Trạng thái -->
      <div>
        <label for="status" class="block font-medium text-sm text-slate-700 mb-1">Trạng thái kinh doanh</label>
        <select id="status" name="status" class="w-full p-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none bg-white">
          <option value="active" selected>Đang kinh doanh (Active)</option>
          <option value="draft">Bản nháp (Draft)</option>
          <option value="out_of_stock">Hết hàng (Out of stock)</option>
        </select>
      </div>
    </div>

    <!-- MÔ TẢ SẢN PHẨM -->
    <div>
      <label for="description" class="block font-medium text-sm text-slate-700 mb-1">Mô tả sản phẩm</label>
      <textarea id="description" name="description" rows="3" class="w-full p-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="Mô tả chi tiết về sản phẩm..."></textarea>
    </div>

    <!-- QUẢN LÝ HÌNH ẢNH -->
    <div class="border-t border-slate-200 pt-4">
      <label class="block font-semibold text-slate-800 mb-2">Hình ảnh sản phẩm:</label>
      
      <div id="image-rows-container" class="space-y-3">
        <!-- Dòng nhập ảnh đầu tiên -->
        <div class="image-row p-3 border border-slate-200 rounded-lg bg-slate-50 flex flex-col md:flex-row items-center gap-3">
          <div class="flex-1 w-full">
            <input type="text" name="urlImages" placeholder="Dán link ảnh (URL)..." class="w-full p-2 text-sm border rounded-md bg-white">
          </div>
          <span class="text-xs font-bold text-slate-400 uppercase">Hoặc</span>
          <div class="flex-1 w-full">
            <input type="file" name="fileImages" accept="image/*" class="w-full text-xs text-slate-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 cursor-pointer">
          </div>
        </div>
      </div>

      <button type="button" onclick="addImageRow()" class="mt-3 text-xs bg-slate-200 hover:bg-slate-300 px-3 py-1.5 rounded-md font-medium text-slate-700 transition">
        + Thêm ô nhập ảnh
      </button>
    </div>

    <!-- QUẢN LÝ BIẾN THỂ (VARIANTS) -->
    <div class="border-t border-slate-200 pt-4">
      <div class="flex items-center justify-between mb-2">
        <label class="font-semibold text-slate-800">Biến thể sản phẩm (Kích thước / Màu sắc / Giá riêng):</label>
        <button type="button" onclick="addVariantRow()" class="text-xs bg-blue-50 hover:bg-blue-100 text-blue-700 px-3 py-1.5 rounded-md font-medium transition border border-blue-200">
          + Thêm biến thể
        </button>
      </div>

      <div id="variant-rows-container" class="space-y-2">
        <!-- Dynamic Variants will be appended here -->
      </div>
    </div>

    <!-- NÚT HÀNH ĐỘNG -->
    <div class="pt-4 flex gap-3 border-t border-slate-200">
      <a href="/products" class="flex-1 text-center bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-2.5 rounded-lg transition">
        Hủy
      </a>
      <button type="submit" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 rounded-lg transition">
        Tạo sản phẩm
      </button>
    </div>
  </form>
</div>

<!-- SCRIPT THÊM DÒNG ẢNH & DÒNG BIẾN THỂ -->
<script>
  // Dynamic Image Input
  function addImageRow() {
    const container = document.getElementById('image-rows-container');
    const newRow = document.createElement('div');
    newRow.className = 'image-row p-3 border border-slate-200 rounded-lg bg-slate-50 flex flex-col md:flex-row items-center gap-3';
    newRow.innerHTML = `
      <div class="flex-1 w-full">
        <input type="text" name="urlImages" placeholder="Dán link ảnh (URL)..." class="w-full p-2 text-sm border rounded-md bg-white">
      </div>
      <span class="text-xs font-bold text-slate-400 uppercase">Hoặc</span>
      <div class="flex-1 w-full">
        <input type="file" name="fileImages" accept="image/*" class="w-full text-xs text-slate-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 cursor-pointer">
      </div>
    `;
    container.appendChild(newRow);
  }

  // Dynamic Variant Input
  let variantIndex = 0;
  function addVariantRow() {
    const container = document.getElementById('variant-rows-container');
    const row = document.createElement('div');
    row.className = 'p-3 border border-slate-200 rounded-lg bg-slate-50 grid grid-cols-2 md:grid-cols-4 gap-2 items-center';
    row.innerHTML = `
      <input type="text" name="variants[${variantIndex}][size]" placeholder="Size (VD: XL, 1m2...)" class="p-2 text-xs border rounded bg-white">
      <input type="text" name="variants[${variantIndex}][color]" placeholder="Màu (VD: Trắng, Gỗ...)" class="p-2 text-xs border rounded bg-white">
      <input type="number" name="variants[${variantIndex}][stock]" min="0" placeholder="Số lượng kho" class="p-2 text-xs border rounded bg-white">
      <input type="number" name="variants[${variantIndex}][price]" min="0" placeholder="Giá riêng (nếu có)" class="p-2 text-xs border rounded bg-white">
    `;
    container.appendChild(row);
    variantIndex++;
  }
</script>