<div class="space-y-6">
  <!-- Header & Add Button -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold">Danh sách Sản phẩm</h1>
      <p class="text-slate-500 dark:text-slate-400 text-sm">Quản lý kho hàng, thông tin và giá bán sản phẩm.</p>
    </div>
    <button class="flex items-center justify-center space-x-2 bg-brand-700 hover:bg-brand-700 text-white px-4 py-2.5 rounded-lg transition font-medium">
      <i data-lucide="plus" class="w-5 h-5"></i>
      <a href="/products/trash" class="text-white hover:text-white">Trashed</a>
    </button>
    
    <button class="flex items-center justify-center space-x-2 bg-brand-600 hover:bg-brand-700 text-white px-4 py-2.5 rounded-lg transition font-medium">
      <i data-lucide="plus" class="w-5 h-5"></i>
      <a href="/products/create" class="text-white hover:text-white">Thêm Sản Phẩm</a>
    </button>
  </div>

  <!-- Products Table Container -->
  <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">

<thead>
  <tr>
    <th class="p-4">#</th>
    <th class="p-4">{{{sortable 'name' _sort}}}</th>
    <th class="p-4">{{{sortable 'createdAt' _sort}}}</th>
    <th class="p-4">{{{sortable 'price' _sort}}}</th>
    <th class="p-4">{{{sortable 'stock' _sort}}}</th>
    <th class="p-4 text-right">Thao tác</th>
  </tr>
</thead>

        <tbody class="divide-y divide-slate-200 dark:divide-slate-700 text-sm">
          {{#each products}}
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition">
            <td class="p-4">{{sum @index 1}}</td>
            <td class="p-4 flex items-center space-x-3">
              <img src="{{this.images.[0]}}" class="w-10 h-10 rounded-lg object-cover bg-slate-100">
              <span class="font-medium text-slate-800 dark:text-white">{{this.name}}</span>
              <a href="/product-detail/{{this.slug}}" class="text-xs text-slate-500 dark:text-slate-400 hover:underline">Xem chi tiết</a>
            </td>
            {{!-- <td class="p-4 text-slate-500 dark:text-slate-400 font-mono text-xs">{{this.sku}}</td> --}}
            {{!-- <td class="p-4"><span class="px-2.5 py-1 bg-slate-100 dark:bg-slate-700 rounded-full text-xs font-medium">{{this.category}}</span></td> --}}
            <td class="p-4 text-slate-500 dark:text-slate-400 font-mono text-xs">{{formatDate this.createdAt}}</td>
            <td class="p-4 font-semibold text-slate-800 dark:text-white">{{formatCurrency this.price}}</td>
            <td class="p-4">
              <span class="px-2 py-1 text-xs font-semibold rounded {{#if (gt this.stock 0)}}bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400{{else}}bg-rose-100 text-rose-700{{/if}}">
                {{this.stock}} sp
              </span>
            </td>
            <td class="p-4 text-right space-x-2">
              <button>
              <a href="/products/{{this._id}}/edit" class="p-1.5 text-slate-500 hover:text-brand-600 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700">
                <i data-lucide="edit-3" class="w-4 h-4"></i>
              </a>
              </button>

            <button>
<a href="#"
   class="delete-product-btn p-1.5 text-slate-500 hover:text-red-600 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700"
   data-id="{{this._id}}"
   data-name="{{this.name}}">

    <i data-lucide="trash-2" class="w-4 h-4"></i>

</a>
            </button>



            </td>
          </tr>
          {{else }}
          <tr>
            <td colspan="6" class="p-4 text-center text-slate-500 dark:text-slate-400">
              Không có sản phẩm nào trong kho hàng.
            </td>
          {{/each}}
        </tbody>
      </table>
<div id="delete-product-modal"
     class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 px-4">

    <div class="w-full max-w-md bg-white dark:bg-slate-800 rounded-xl shadow-xl">

        <div class="flex items-center justify-between p-5 border-b border-slate-200 dark:border-slate-700">
            <h2 id="delete-modal-title" class="text-lg font-semibold text-slate-800 dark:text-white">
                Xác nhận xóa
            </h2>

            <button type="button" id="close-delete-modal" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <div class="p-5">
            <p class="text-slate-600 dark:text-slate-300">
                Bạn có chắc muốn xóa sản phẩm
                <strong id="delete-product-name" class="text-slate-900 dark:text-white"></strong>?
            </p>

            <p id="delete-modal-warning" class="mt-2 text-sm text-amber-500">
                Sản phẩm sẽ được chuyển vào thùng rác.
            </p>
        </div>

        <div class="flex justify-end gap-3 p-5 border-t border-slate-200 dark:border-slate-700">

            <button type="button"
                    id="cancel-delete"
                    class="px-4 py-2 rounded-lg border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 font-medium transition">
                Hủy
            </button>

            <button type="button"
                    id="confirm-delete"
                    class="px-4 py-2 rounded-lg bg-red-600 hover:bg-red-700 text-white font-medium transition">
                Xóa sản phẩm
            </button>

        </div>

    </div>
</div>
    </div>
  </div>
</div>